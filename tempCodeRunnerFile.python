from bs4 import BeautifulSoup
import requests

import requests
from bs4 import BeautifulSoup

# 1. The URL you want to scrape
url = "https://www.tokopedia.com/p/audio-kamera-elektronik-lainnya/kamera-digital"

# 2. Send a request to the website
response = requests.get(url)

# 3. Parse the HTML content
# We use .content because it handles character encoding better than .text
soup = BeautifulSoup(response.content, "html.parser")

# 4. Find the data you want
# Let's find the main heading (h1)
heading = soup.find("h1")

print(f"The heading is: {heading.text}")